{
  "name": "barangay-connect",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:admin": "npm --workspace apps/admin-crm run dev",
    "dev:resident": "npm --workspace apps/resident-web run dev",
    "build": "npm run build:admin && npm run build:resident",
    "build:admin": "npm --workspace apps/admin-crm run build",
    "build:resident": "npm --workspace apps/resident-web run build",
    "lint": "npm run lint:admin && npm run lint:resident",
    "lint:admin": "npm --workspace apps/admin-crm run lint",
    "lint:resident": "npm --workspace apps/resident-web run lint",
    "typecheck": "npm run typecheck:admin && npm run typecheck:resident",
    "typecheck:admin": "npm --workspace apps/admin-crm run typecheck",
    "typecheck:resident": "npm --workspace apps/resident-web run typecheck",
    "bootstrap:admin": "npm --workspace apps/admin-crm run bootstrap:admin"
  }
}
